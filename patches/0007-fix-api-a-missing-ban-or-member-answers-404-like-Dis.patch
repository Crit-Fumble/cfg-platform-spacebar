@@ -580,7 +580,7 @@ export const DiscordApiErrors = {
         return new ApiError("Unknown session", 10020);
     },
     get UNKNOWN_BAN() {
-        return new ApiError("Unknown ban", 10026);
+        return new ApiError("Unknown ban", 10026, 404);
     },
     get UNKNOWN_SKU() {
         return new ApiError("Unknown SKU", 10027);
